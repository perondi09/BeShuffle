# Copy this file to .env and fill in your credentials
# cp .env.example .env
#
# infra/.env is the only place for keys and passwords (it is gitignored).
# Docker Compose reads it, and the app reads it too when started from the
# project root (IDE or ./mvnw spring-boot:run). There are no fallback values:
# the app refuses to start if DB_PASSWORD or the Spotify keys are missing.

SERVER_PORT=8080
# Port of the site (nginx) on this machine
FRONTEND_PORT=3000

# Login session cookie: set COOKIE_SECURE=true in production (HTTPS only).
# SESSION_TIMEOUT is how long a login lasts (Spring duration, e.g. 7d, 12h).
COOKIE_SECURE=false
SESSION_TIMEOUT=7d
SPRING_PROFILES_ACTIVE=default

DB_NAME=beshuffle_db
DB_USER=postgres
DB_PASSWORD=change-me

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Only needed when running the API outside Docker against another database.
# DB_HOST=localhost
# DB_PORT=5435